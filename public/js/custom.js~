function validateCode(str) {
  if ($('body').hasClass('category-id-16')) {
      var re = /(\d{2})(\d{2})?(\d{2})?/;
      return str.match(re);
  } else {
    if (str.substr(0,1) == '0') {
      str = str.substr(1,7);
    }
    if (str.length == 2) {
      var re = /(\d{2})?/;
      return str.match(re);
    }
    else if (str.length == 4) {
      var re = /(\d{2})(\d{2})?/;
      return str.match(re);
    }
    else if (str.length == 6) {
      var re = /(\d{2})(\d{2})?(\d{2})?/;
      return str.match(re);
    } else {
      var re = /(\d{3})(\d{2})?(\d{2})?/;
      return str.match(re);
    }
  }
}
