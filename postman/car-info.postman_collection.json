{
  "info": {
    "name": "Car Info API",
    "description": "Коллекция для теста /api/car-info с CSRF и HMAC-токеном.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Page (tokens)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://{{base_url}}/pieraksts",
          "protocol": "https",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pieraksts"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const html = pm.response.text();",
              "",
              "const csrfMatch = html.match(/name=\"csrf-token\"\\s+content=\"([^\"]+)\"/i);",
              "if (csrfMatch) {",
              "  pm.environment.set(\"csrf_token\", csrfMatch[1]);",
              "}",
              "",
              "const tokenMatch = html.match(/name=\"car_info_token\"\\s+value=\"([^\"]+)\"/i);",
              "if (tokenMatch) {",
              "  pm.environment.set(\"car_info_token\", tokenMatch[1]);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Car Info",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrf_token}}"
          },
          {
            "key": "X-Car-Info-Token",
            "value": "{{car_info_token}}"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "vnr",
              "value": "LK4651",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "https://{{base_url}}/api/car-info",
          "protocol": "https",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "car-info"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const nextToken = pm.response.headers.get(\"X-Car-Info-Token\");",
              "if (nextToken) {",
              "  pm.environment.set(\"car_info_token\", nextToken);",
              "}"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "example.com"
    }
  ]
}
